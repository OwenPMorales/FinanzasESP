# Copia este archivo como .env y ajusta tus valores:  copy .env.example .env
PROJECT_NAME=FinanzasESP

# --- Base de datos (PostgreSQL del docker-compose)
DATABASE_URL=postgresql+psycopg://finanzas:finanzas_secret_2026@localhost:5440/finanzasdb
USE_ALEMBIC=true

# --- Seguridad: genera tu propia clave con
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets
TOKEN_ALGORITHM=HS256
JWT_ISSUER=finanzas-esp
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEVICE_TOKEN_EXPIRE_MINUTES=60

# --- Argon2id (parametros recomendados por OWASP: m=19 MiB, t=2, p=1)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1

# --- CORS (frontends locales de desarrollo)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# --- MinIO (docker-compose up -d)
MINIO_ENDPOINT=localhost:9030
# Host que veran los navegadores / el ESP en las URLs prefirmadas.
# Si el ESP32 abre las imagenes, pon aqui la IP LAN de la PC, ej. 192.168.1.50:9030
MINIO_PUBLIC_ENDPOINT=localhost:9030
MINIO_ACCESS_KEY=finanzas_admin
MINIO_SECRET_KEY=finanzas_minio_2026
MINIO_BUCKET=finanzas-esp
MINIO_SECURE=false
MINIO_REGION=us-east-1
PRESIGNED_URL_EXPIRE_MINUTES=15
MAX_UPLOAD_MB=5
